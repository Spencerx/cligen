prefix		= @prefix@
datarootdir	= @datarootdir@
exec_prefix	= @exec_prefix@
bindir		= @bindir@
libdir		= @libdir@
srcdir		= @srcdir@

TARGETS         = fuzz_cv fuzz_match fuzz_spec

.PHONY: all clean run run_spec run_match run_cv

all:	$(TARGETS)

clean:
	rm -f $(TARGETS)

$(TARGETS):
	./build.sh $@

run_spec:   fuzz_spec
	nohup ./fuzz_spec corpus_spec -dict=cligen.dict -fork=4 -ignore_crashes=1 -ignore_timeouts=1 -ignore_ooms=1 -max_len=4096 -rss_limit_mb=2048 -timeout=10 -artifact_prefix=artifacts_spec/ > spec.log 2>&1

run_match:   fuzz_match
	nohup ./fuzz_match corpus_match -dict=cligen.dict -fork=4 -ignore_crashes=1 -ignore_timeouts=1 -ignore_ooms=1 -max_len=512 -rss_limit_mb=2048 -timeout=10 -artifact_prefix=artifacts_match/ > match.log 2>&1

run_cv:   fuzz_cv
	nohup ./fuzz_cv corpus_cv -fork=4 -ignore_crashes=1 -ignore_timeouts=1 -ignore_ooms=1 -max_len=128 -rss_limit_mb=2048 -timeout=10 -artifact_prefix=artifacts_cv/ > cv.log 2>&1
